<div class="uniko-pdp-keys" aria-labelledby="uniko-pdp-keys-title">
  <div class="uniko-pdp-keys-inner">
    <h2 class="uniko-pdp-keys-title" id="uniko-pdp-keys-title" data-i18n="pdp_keys_title">Key Ingredients</h2>
    <div class="uniko-pdp-keys-carousel" data-pdp-ing-carousel>
      <button type="button" class="uniko-pdp-keys-nav uniko-pdp-keys-nav--prev" data-pdp-ing-prev aria-label="Previous ingredients">‹</button>
      <div class="uniko-pdp-keys-track" tabindex="0" role="list">
        <article class="uniko-pdp-key-card" role="listitem">
          <div class="uniko-pdp-key-icon" aria-hidden="true">
            <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
              <path d="M24 8c-8 10-11 20-8 28 2.5 6 7 9 12 8 6-1 10-6 10-14 0-12-10-22-14-22Z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="uniko-pdp-key-body">
            <h3 class="uniko-pdp-key-name" data-i18n="pdp_spray_key1_title">Water</h3>
            <p class="uniko-pdp-key-text" data-i18n="pdp_spray_key1_desc">A light, clean base that helps deliver the botanical blend across the scalp.</p>
          </div>
        </article>
        <article class="uniko-pdp-key-card" role="listitem">
          <div class="uniko-pdp-key-icon" aria-hidden="true">
            <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
              <path d="M12 34c4-14 14-22 24-26M10 28c8-6 14-12 18-22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <path d="M16 36h16" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="uniko-pdp-key-body">
            <h3 class="uniko-pdp-key-name" data-i18n="pdp_spray_key2_title">Cinnamon</h3>
            <p class="uniko-pdp-key-text" data-i18n="pdp_spray_key2_desc">A warming botanical note in our nighttime hair care ritual.</p>
          </div>
        </article>
        <article class="uniko-pdp-key-card" role="listitem">
          <div class="uniko-pdp-key-icon" aria-hidden="true">
            <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
              <path d="M24 10c-4 0-7 3-7 7 0 4 3 5 7 9 4-4 7-5 7-9 0-4-3-7-7-7Z" stroke="currentColor" stroke-width="1.5"/>
              <path d="M24 26v12" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            </svg>
          </div>
          <div class="uniko-pdp-key-body">
            <h3 class="uniko-pdp-key-name" data-i18n="pdp_spray_key3_title">Clove</h3>
            <p class="uniko-pdp-key-text" data-i18n="pdp_spray_key3_desc">Completes the aromatic blend for an indulgent evening scalp routine.</p>
          </div>
        </article>
      </div>
      <button type="button" class="uniko-pdp-keys-nav uniko-pdp-keys-nav--next" data-pdp-ing-next aria-label="Next ingredients">›</button>
    </div>
  </div>
</div>

<div class="uniko-pdp-faq">
  <div class="uniko-pdp-block-inner">
    <h2 class="uniko-pdp-block-title" data-i18n="pdp_faq_title">Frequently asked questions</h2>
    <div class="uniko-pdp-faq-list">
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_spray_faq_q1">Do I rinse after applying?</summary>
        <p data-i18n="pdp_spray_faq_a1">No. This is a leave-on bedtime spray — apply and let it work overnight without rinsing.</p>
      </details>
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_spray_faq_q2">When should I use it?</summary>
        <p data-i18n="pdp_spray_faq_a2">Use before going to bed on clean, dry or towel-dried hair.</p>
      </details>
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_spray_faq_q3">Who is this spray for?</summary>
        <p data-i18n="pdp_spray_faq_a3">Designed for women and girls as part of the UniKo Beauties Hair Care Range.</p>
      </details>
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_spray_faq_q4">Where should I spray?</summary>
        <p data-i18n="pdp_spray_faq_a4">Focus on the scalp, then lightly mist through lengths if desired.</p>
      </details>
    </div>
  </div>
</div>

<div class="uniko-pdp-compare">
  <div class="uniko-pdp-block-inner">
    <h2 class="uniko-pdp-block-title" data-i18n="pdp_compare_title">How we compare</h2>
    <div class="uniko-pdp-compare-scroll">
      <table class="uniko-pdp-compare-table">
        <thead>
          <tr>
            <th scope="col" data-i18n="pdp_cmp_feature">Feature</th>
            <th scope="col" class="is-highlight">{{ product.title }}</th>
            <th scope="col" data-i18n="pdp_spray_cmp_col2">Regular hairspray</th>
            <th scope="col" data-i18n="pdp_spray_cmp_col3">Typical scalp oil</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" data-i18n="pdp_spray_cmp_row1">Overnight leave-on</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_sometimes">Sometimes</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_spray_cmp_row2">Scalp-focused mist</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
            <td><span class="uniko-pdp-yes">✓</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_spray_cmp_row3">No rinse needed</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_spray_cmp_row4">Cinnamon & clove blend</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_spray_cmp_row5">For women & girls</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<section class="reviews-section uniko-pdp-reviews" id="pdp-avis" aria-labelledby="pdp-reviews-title">
  <div class="uniko-pdp-block-inner">
    <div class="reviews-head">
      <h2 id="pdp-reviews-title" data-i18n="pdp_reviews_title">Customer reviews</h2>
      <div class="reviews-meta" aria-label="Average rating 5 out of 5">
        <span class="review-stars" aria-hidden="true">★★★★★</span>
        <span data-i18n="pdp_spray_reviews_meta">5.0 · 18 reviews</span>
      </div>
    </div>
    <div class="review-cards-carousel" data-pdp-review-carousel>
      <button type="button" class="carousel-btn carousel-btn--prev" data-carousel-prev aria-label="Previous reviews">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.5 5.5 9 11l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="review-cards-track" tabindex="0" role="list">
        <article class="review-card" role="listitem">
