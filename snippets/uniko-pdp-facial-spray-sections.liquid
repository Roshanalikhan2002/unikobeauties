<div class="uniko-pdp-keys" aria-labelledby="uniko-pdp-keys-title">
  <div class="uniko-pdp-keys-inner">
    <h2 class="uniko-pdp-keys-title" id="uniko-pdp-keys-title" data-i18n="pdp_keys_title">Key Ingredients</h2>
    <div class="uniko-pdp-keys-carousel" data-pdp-ing-carousel>
      <button type="button" class="uniko-pdp-keys-nav uniko-pdp-keys-nav--prev" data-pdp-ing-prev aria-label="Previous ingredients">‹</button>
      <div class="uniko-pdp-keys-track" tabindex="0" role="list">
        <article class="uniko-pdp-key-card" role="listitem">
          <div class="uniko-pdp-key-icon" aria-hidden="true">
            <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
              <path d="M24 4C14 18 10 28 12 38c2 8 8 10 12 10s10-2 12-10c2-10-2-20-12-34Z" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="uniko-pdp-key-body">
            <h3 class="uniko-pdp-key-name" data-i18n="pdp_facial_key1_title">Aloe vera</h3>
            <p class="uniko-pdp-key-text" data-i18n="pdp_facial_key1_desc">A gentle botanical mist for the face after cleansing with YIRI soap.</p>
          </div>
        </article>
        <article class="uniko-pdp-key-card" role="listitem">
          <div class="uniko-pdp-key-icon" aria-hidden="true">
            <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
              <path d="M24 10v8M20 18h8M14 32c4-8 12-12 20-14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="24" cy="24" r="6" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
          <div class="uniko-pdp-key-body">
            <h3 class="uniko-pdp-key-name" data-i18n="pdp_facial_key2_title">Vitamin E</h3>
            <p class="uniko-pdp-key-text" data-i18n="pdp_facial_key2_desc">An antioxidant care note to finish the morning and evening face ritual.</p>
          </div>
        </article>
        <article class="uniko-pdp-key-card" role="listitem">
          <div class="uniko-pdp-key-icon" aria-hidden="true">
            <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
              <path d="M18 14h12M16 34c4-10 16-10 20 0" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              <circle cx="24" cy="20" r="5" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </div>
          <div class="uniko-pdp-key-body">
            <h3 class="uniko-pdp-key-name" data-i18n="pdp_facial_key3_title">After YIRI soap</h3>
            <p class="uniko-pdp-key-text" data-i18n="pdp_facial_key3_desc">Apply only after a thorough cleanse with YIRI soap — no other products added.</p>
          </div>
        </article>
      </div>
      <button type="button" class="uniko-pdp-keys-nav uniko-pdp-keys-nav--next" data-pdp-ing-next aria-label="Next ingredients">›</button>
    </div>
  </div>
</div>

<div class="uniko-pdp-faq">
  <div class="uniko-pdp-block-inner">
    <h2 class="uniko-pdp-block-title" data-i18n="pdp_faq_title">Frequently asked questions</h2>
    <div class="uniko-pdp-faq-list">
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_facial_faq_q1">How do I use Facial Spray?</summary>
        <p data-i18n="pdp_facial_faq_a1">Shake well and gently apply after thoroughly cleansing your face with YIRI soap.</p>
      </details>
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_facial_faq_q2">When should I use it?</summary>
        <p data-i18n="pdp_facial_faq_a2">Use it in the morning and evening, without adding any other products.</p>
      </details>
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_facial_faq_q3">Who is it for?</summary>
        <p data-i18n="pdp_facial_faq_a3">Formulated for women and girls.</p>
      </details>
      <details class="uniko-pdp-faq-item">
        <summary data-i18n="pdp_facial_faq_q4">What is in Facial Spray?</summary>
        <p data-i18n="pdp_facial_faq_a4">Aloe vera and vitamin E.</p>
      </details>
    </div>
  </div>
</div>

