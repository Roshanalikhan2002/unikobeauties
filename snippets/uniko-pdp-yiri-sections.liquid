          <tr>
            <th scope="row" data-i18n="pdp_yiri_cmp_row4">Sulfate-free botanicals</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_sometimes">Sometimes</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_yiri_cmp_row5">Men, women &amp; kids</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<section class="reviews-section uniko-pdp-reviews" id="pdp-avis" aria-labelledby="pdp-reviews-title">
  <div class="uniko-pdp-block-inner">
    <div class="reviews-head">
      <h2 id="pdp-reviews-title" data-i18n="pdp_reviews_title">Customer reviews</h2>
      <div class="reviews-meta" aria-label="Average rating 5 out of 5">
        <span class="review-stars" aria-hidden="true">★★★★★</span>
        <span data-i18n="pdp_yiri_reviews_meta">5.0 · 16 reviews</span>
      </div>
    </div>
    <div class="review-cards-carousel" data-pdp-review-carousel>
      <button type="button" class="carousel-btn carousel-btn--prev" data-carousel-prev aria-label="Previous reviews">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M14.5 5.5 9 11l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <div class="review-cards-track" tabindex="0" role="list">
        <article class="review-card" role="listitem">
          <div class="review-card-top">
            <div>
              <p class="review-card-name">Fatou D.</p>
              <p class="review-verified">
