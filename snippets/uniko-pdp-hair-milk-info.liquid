<div class="uniko-pdp-info-col">
  <a class="uniko-pdp-back" href="{{ routes.root_url }}">← <span data-i18n="pdp_back">Back to shop</span></a>

  <p class="uniko-pdp-eyebrow" data-i18n="pdp_milk_eyebrow">UniKo Beauties | Hair Care Range</p>
  <h1 class="uniko-pdp-title">{{ product.title }}</h1>
  <p class="uniko-pdp-audience" data-i18n="pdp_milk_who">For who: Men, Women, Kids — the whole family</p>

  <div class="uniko-pdp-rating" role="img" aria-label="5 out of 5 stars">
    <span class="uniko-pdp-stars" aria-hidden="true">★★★★★</span>
    <span class="uniko-pdp-rating-val">5.0</span>
  </div>

  <div class="uniko-pdp-lead rte">
    <p data-i18n="pdp_milk_desc_en">This 3-in-1 hair milk with a creamy texture helps hydrate and nourish your hair daily while supporting a beautiful look. Rich in fiber-loving care for naturally defined curls, in shaa Allah.</p>
    <p class="uniko-pdp-lead-fr" data-i18n="pdp_milk_desc_fr" lang="fr">Ce lait capillaire 3-en-1 à texture crémeuse hydrate et nourrit au quotidien tout en préservant une belle tenue. Soin riche pour des boucles naturellement définies, in shaa Allah.</p>
  </div>

  <div class="uniko-pdp-price-block">
    {% if product.selected_or_first_available_variant.price > 0 %}
      <p class="uniko-pdp-price">{{ product.selected_or_first_available_variant.price | money }}</p>
      {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
        <p class="uniko-pdp-compare"><s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s></p>
      {% endif %}
    {% endif %}
  </div>

  {% form 'product', product, id: 'uniko-pdp-form', class: 'uniko-pdp-form' %}
    <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
    <div class="uniko-pdp-buy">
      <div class="uniko-pdp-qty">
        <button type="button" class="uniko-pdp-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
        <input type="number" name="quantity" value="1" min="1" class="uniko-pdp-qty-input" aria-label="Quantity">
        <button type="button" class="uniko-pdp-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
      </div>
      <button type="submit" name="add" class="uniko-pdp-atc" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
        {% if product.selected_or_first_available_variant.available %}
          <span data-i18n="pdp_atc">Add to cart</span>
        {% else %}
          <span data-i18n="pdp_soldout">Sold out</span>
        {% endif %}
      </button>
    </div>
  {% endform %}

  {% if product.description != blank %}
    <div class="uniko-pdp-admin-desc rte">{{ product.description }}</div>
  {% endif %}

  <div class="uniko-pdp-accordions">
    <details class="uniko-pdp-acc" open>
      <summary data-i18n="pdp_acc_certs">Certifications</summary>
      <div class="uniko-pdp-cert-row" role="list" aria-label="Certifications">
        <div class="uniko-pdp-cert-badge" role="listitem">
          <img src="{{ 'uniko-trust-badges-01-ofc-organic.png' | asset_img_url: 'width: 320' }}" alt="Certified Organic Australia" loading="lazy" width="88" height="88">
        </div>
        <div class="uniko-pdp-cert-badge" role="listitem">
          <img src="{{ 'uniko-trust-badges-02-peta.png' | asset_img_url: 'width: 320' }}" alt="Animal test-free, PETA" loading="lazy" width="88" height="88">
        </div>
        <div class="uniko-pdp-cert-badge" role="listitem">
          <img src="{{ 'uniko-trust-badges-03-vegan.png' | asset_img_url: 'width: 320' }}" alt="Certified Vegan" loading="lazy" width="88" height="88">
        </div>
        <div class="uniko-pdp-cert-badge" role="listitem">
          <img src="{{ 'uniko-trust-badges-06-halal.png' | asset_img_url: 'width: 320' }}" alt="Halal accredited" loading="lazy" width="88" height="88">
        </div>
      </div>
    </details>

    <details class="uniko-pdp-acc">
      <summary data-i18n="pdp_acc_how">How to use</summary>
      <div class="uniko-pdp-acc-body">
        <p data-i18n="pdp_milk_how_en">Apply every morning. Also use as a mask, a leave-in, or a detangler.</p>
        <p lang="fr" data-i18n="pdp_milk_how_fr">Appliquer chaque matin. Utilisable aussi en masque, sans rinçage ou démêlant.</p>
      </div>
    </details>

    <details class="uniko-pdp-acc">
      <summary data-i18n="pdp_acc_ing">Ingredients</summary>
      <div class="uniko-pdp-acc-body">
        <p><strong data-i18n="pdp_ing_label_en">Ingredients:</strong> <span data-i18n="pdp_milk_ing_en">Aloe vera, vitamin E, natural exotic scent, pure sesame butter or shea butter, basil.</span></p>
        <p lang="fr"><strong data-i18n="pdp_ing_label_fr">Ingrédients :</strong> <span data-i18n="pdp_milk_ing_fr">Aloe vera, vitamine E, senteur exotique naturelle, beurre de sésame pur ou beurre de karité, basilique.</span></p>
      </div>
    </details>
  </div>
</div>