            <td><span class="uniko-pdp-no">—</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_det_cmp_row3">Aloe, shea &amp; vitamin E</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_sometimes">Sometimes</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_det_cmp_row4">Basil &amp; peppermint oils</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
            <td><span class="uniko-pdp-no">—</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_det_cmp_row5">Men, women &amp; kids</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<section class="reviews-section uniko-pdp-reviews" id="pdp-avis" aria-labelledby="pdp-reviews-title">
