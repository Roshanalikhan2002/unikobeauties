    <h2 class="uniko-pdp-block-title" data-i18n="pdp_compare_title">How we compare</h2>
    <div class="uniko-pdp-compare-scroll">
      <table class="uniko-pdp-compare-table">
        <thead>
          <tr>
            <th scope="col" data-i18n="pdp_cmp_feature">Feature</th>
            <th scope="col" class="is-highlight">{{ product.title }}</th>
            <th scope="col" data-i18n="pdp_det_cmp_col2">Regular detangler</th>
            <th scope="col" data-i18n="pdp_det_cmp_col3">Drugstore cream</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" data-i18n="pdp_det_cmp_row1">Whole-family use</th>
            <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
            <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
          </tr>
          <tr>
            <th scope="row" data-i18n="pdp_det_cmp_row2">Scalp-focused application</th>
