<script>
  (function () {
    const root = document.querySelector("[data-uniko-pdp]");
    if (!root) return;
    const qtyInput = root.querySelector(".uniko-pdp-qty-input");
    root.querySelector("[data-qty-minus]")?.addEventListener("click", () => {
      if (!qtyInput) return;
      qtyInput.value = String(Math.max(1, parseInt(qtyInput.value, 10) - 1 || 1));
    });
    root.querySelector("[data-qty-plus]")?.addEventListener("click", () => {
      if (!qtyInput) return;
      qtyInput.value = String(Math.max(1, parseInt(qtyInput.value, 10) + 1 || 2));
    });
    const form = root.querySelector("#uniko-pdp-form");
    const sticky = root.querySelector("#uniko-pdp-sticky");
    const stickyAtc = root.querySelector("[data-sticky-atc]");
    const buy = root.querySelector(".uniko-pdp-buy");
    if (sticky && buy) {
      const obs = new IntersectionObserver(([e]) => {
        sticky.hidden = e.isIntersecting;
      }, { threshold: 0, rootMargin: "0px 0px -20px 0px" });
      obs.observe(buy);
    }
    stickyAtc?.addEventListener("click", () => form?.requestSubmit());

    const ingWrap = root.querySelector("[data-pdp-ing-carousel]");
    const ingTrack = ingWrap?.querySelector(".uniko-pdp-keys-track");
    const ingPrev = ingWrap?.querySelector("[data-pdp-ing-prev]");
    const ingNext = ingWrap?.querySelector("[data-pdp-ing-next]");
    if (ingTrack && ingNext) {
      const ingStep = () => {
        const card = ingTrack.querySelector(".uniko-pdp-key-card");
        if (!card) return 320;
        const gap = parseFloat(getComputedStyle(ingTrack).gap) || 16;
        return card.getBoundingClientRect().width + gap;
      };
      const syncIngNav = () => {
        const mobile = window.matchMedia("(max-width: 900px)").matches;
        if (ingPrev) {
          ingPrev.hidden = !mobile;
          ingPrev.disabled = mobile && ingTrack.scrollLeft <= 4;
        }
        ingNext.hidden = !mobile;
        ingNext.disabled =
          mobile && ingTrack.scrollLeft + ingTrack.clientWidth >= ingTrack.scrollWidth - 4;
      };
      ingNext.addEventListener("click", () => {
        ingTrack.scrollBy({ left: ingStep(), behavior: "smooth" });
        setTimeout(syncIngNav, 350);
      });
      ingPrev?.addEventListener("click", () => {
        ingTrack.scrollBy({ left: -ingStep(), behavior: "smooth" });
        setTimeout(syncIngNav, 350);
      });
      ingTrack.addEventListener("scroll", syncIngNav, { passive: true });
      window.addEventListener("resize", syncIngNav);
      syncIngNav();
    }

    root.querySelectorAll("[data-pdp-review-carousel]").forEach((carousel) => {
      const track = carousel.querySelector(".review-cards-track");
      const prev = carousel.querySelector("[data-carousel-prev]");
      const next = carousel.querySelector("[data-carousel-next]");
      if (!track || !next) return;
      const scrollStep = () => {
        const card = track.querySelector(".review-card");
        if (!card) return 358;
        const gap = parseFloat(getComputedStyle(track).gap) || 18;
        return card.getBoundingClientRect().width + gap;
      };
      next.addEventListener("click", () => {
        track.scrollBy({ left: scrollStep(), behavior: "smooth" });
      });
      prev?.addEventListener("click", () => {
        track.scrollBy({ left: -scrollStep(), behavior: "smooth" });
      });
    });
  })();
</script>

