{% comment %}Inika-style product page — Uniko Beauties{% endcomment %}
<section class="uniko-pdp" id="product" data-uniko-pdp>
  <div class="uniko-pdp-wrap">
    <div class="uniko-pdp-gallery-col">
      <div class="uniko-pdp-main">
        {% if product.featured_media %}
          {{ product.featured_media
            | image_url: width: 1600
            | image_tag:
              class: 'uniko-pdp-main-img',
              loading: 'eager',
              alt: product.title,
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 901px) 54vw, 100vw'
          }}
        {% elsif product.images.first %}
          {{ product.images.first
            | image_url: width: 1600
            | image_tag:
              class: 'uniko-pdp-main-img',
              loading: 'eager',
              alt: product.title,
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 901px) 54vw, 100vw'
          }}
        {% endif %}
      </div>
    </div>

    <div class="uniko-pdp-info-col">
      <a class="uniko-pdp-back" href="{{ routes.root_url }}">← <span data-i18n="pdp_back">Back to shop</span></a>

      <p class="uniko-pdp-eyebrow">{{ shop.name }}</p>
      <h1 class="uniko-pdp-title">{{ product.title }}</h1>
      <p class="uniko-pdp-subtitle" data-i18n="pdp_subtitle">Shampoing pour locks ● Shampoo for locks</p>

      <div class="uniko-pdp-rating" role="img" aria-label="5 out of 5 stars">
        <span class="uniko-pdp-stars" aria-hidden="true">★★★★★</span>
        <span class="uniko-pdp-rating-val">5.0</span>
      </div>

      <div class="uniko-pdp-lead rte">
        <p data-i18n="pdp_desc_en">A gentle aloe vera shampoo for body and hair (500 ml). Cleanses while helping maintain moisture and comfort for all skin and hair types. Free from sulfates, silicones and parabens.</p>
        <p class="uniko-pdp-lead-fr" data-i18n="pdp_desc_fr" lang="fr">Shampoing doux à l'aloe vera pour le corps et les cheveux (500 ml). Nettoie tout en préservant l'hydratation — pour tous types de peau et de cheveux. Sans sulfates, silicones ni parabènes.</p>
      </div>

      <p class="uniko-pdp-size" data-i18n="pdp_size">Size: 500 ml</p>

      <div class="uniko-pdp-price-block">
        {% if product.selected_or_first_available_variant.price > 0 %}
          <p class="uniko-pdp-price">{{ product.selected_or_first_available_variant.price | money }}</p>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <p class="uniko-pdp-compare"><s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s></p>
          {% endif %}
        {% endif %}
      </div>

      {% form 'product', product, id: 'uniko-pdp-form', class: 'uniko-pdp-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="uniko-pdp-buy">
          <div class="uniko-pdp-qty">
            <button type="button" class="uniko-pdp-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" class="uniko-pdp-qty-input" aria-label="Quantity">
            <button type="button" class="uniko-pdp-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" name="add" class="uniko-pdp-atc" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            {% if product.selected_or_first_available_variant.available %}
              <span data-i18n="pdp_atc">Add to cart</span>
            {% else %}
              <span data-i18n="pdp_soldout">Sold out</span>
            {% endif %}
          </button>
        </div>
      {% endform %}

      {% if product.description != blank %}
        <div class="uniko-pdp-admin-desc rte">{{ product.description }}</div>
      {% endif %}

      <div class="uniko-pdp-accordions">
        <details class="uniko-pdp-acc" open>
          <summary data-i18n="pdp_acc_certs">Certifications</summary>
          <div class="uniko-pdp-cert-row" role="list" aria-label="Certifications">
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-01-ofc-organic.png' | asset_img_url: 'width: 320' }}" alt="Certified Organic Australia" loading="lazy" width="88" height="88">
            </div>
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-02-peta.png' | asset_img_url: 'width: 320' }}" alt="Animal test-free, PETA" loading="lazy" width="88" height="88">
            </div>
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-03-vegan.png' | asset_img_url: 'width: 320' }}" alt="Certified Vegan" loading="lazy" width="88" height="88">
            </div>
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-06-halal.png' | asset_img_url: 'width: 320' }}" alt="Halal accredited" loading="lazy" width="88" height="88">
            </div>
          </div>
        </details>

        <details class="uniko-pdp-acc">
          <summary data-i18n="pdp_acc_how">How to use</summary>
          <div class="uniko-pdp-acc-body">
            <p data-i18n="pdp_how_en">Shake well and apply the shampoo 1 to 2 times on the entire hair, from the scalp to the tips, then rinse. Repeat if necessary.</p>
            <p lang="fr" data-i18n="pdp_how_fr">Secouer et appliquez 1 à 2 fois le shampoing sur l'ensemble des cheveux en partant du cuir chevelu aux pointes puis rincer. Renouveler le procédé si nécessaire.</p>
          </div>
        </details>

        <details class="uniko-pdp-acc">
          <summary data-i18n="pdp_acc_ing">Ingredients</summary>
          <div class="uniko-pdp-acc-body">
            <p><strong data-i18n="pdp_ing_label_en">Ingredients:</strong> <span data-i18n="pdp_ing_en">Aloe vera, basil, vegetable oils, natural scented water, sodium hydroxide, water.</span></p>
            <p lang="fr"><strong data-i18n="pdp_ing_label_fr">Ingrédients :</strong> <span data-i18n="pdp_ing_fr">Aloe vera, basilique, huiles végétales, eau de senteur naturel, hydroxyde de sodium, eau.</span></p>
          </div>
        </details>
      </div>
    </div>
  </div>

  <div class="uniko-pdp-sticky" id="uniko-pdp-sticky" hidden>
    <div class="uniko-pdp-sticky-inner">
      <div class="uniko-pdp-sticky-meta">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 120 | image_tag: class: 'uniko-pdp-sticky-thumb', alt: '' }}
        {% endif %}
        <div>
          <p class="uniko-pdp-sticky-title">{{ product.title }}</p>
          {% if product.price > 0 %}
            <p class="uniko-pdp-sticky-price">{{ product.price | money }}</p>
          {% endif %}
        </div>
      </div>
      <button type="button" class="uniko-pdp-sticky-atc" data-sticky-atc data-i18n="pdp_atc">Add to cart</button>
    </div>
  </div>
</section>

{% stylesheet %}
  .uniko-pdp { background: #faf8f5; }
  .uniko-pdp-wrap {
    max-width: 1320px;
    margin: 0 auto;
    padding: 20px 18px 80px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .uniko-pdp-gallery-col {
    min-width: 0;
    margin-left: -18px;
    margin-right: -18px;
  }
  .uniko-pdp-main {
    background: #f3ebe3;
    border: 0;
    border-radius: 0;
    min-height: clamp(280px, 48vw, 620px);
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
  }
  .uniko-pdp-main-img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: clamp(280px, 48vw, 620px);
    max-height: min(82vh, 960px);
    object-fit: contain;
    object-position: center;
    border: 0;
    margin: 0;
  }
  .uniko-pdp-back { font-size: 14px; font-weight: 600; color: #6a625a; text-decoration: none; }
  .uniko-pdp-eyebrow {
    margin: 16px 0 8px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b08968;
  }
  .uniko-pdp-title {
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(32px, 4.5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    margin: 0 0 8px;
    color: #2c2622;
  }
  .uniko-pdp-subtitle { margin: 0 0 12px; font-size: 15px; color: #5a534c; }
  .uniko-pdp-rating { display: flex; align-items: center; gap: 8px; margin-bottom: 18px; }
  .uniko-pdp-stars { color: #c9972e; letter-spacing: 1px; }
  .uniko-pdp-rating-val { font-weight: 700; }
  .uniko-pdp-lead { font-size: 15px; line-height: 1.6; color: #4a4540; margin-bottom: 16px; }
  .uniko-pdp-lead-fr { display: none; }
  html[lang="fr"] .uniko-pdp-lead-fr { display: block; }
  html[lang="fr"] [data-i18n="pdp_desc_en"] { display: none; }
  .uniko-pdp-size { font-size: 14px; font-weight: 600; margin: 0 0 16px; }
  .uniko-pdp-price { font-size: 24px; font-weight: 700; margin: 0 0 6px; }
  .uniko-pdp-compare { color: #8a837c; margin: 0 0 8px; }
  .uniko-pdp-price-block { margin-bottom: 22px; }
  .uniko-pdp-buy { display: flex; flex-wrap: wrap; gap: 12px; align-items: stretch; margin-bottom: 28px; }
  .uniko-pdp-qty {
    display: flex;
    align-items: center;
    border: 1px solid #d8d2cb;
    background: #fff;
    border-radius: 2px;
  }
  .uniko-pdp-qty-btn {
    width: 44px;
    height: 52px;
    border: 0;
    background: transparent;
    font-size: 20px;
    cursor: pointer;
  }
  .uniko-pdp-qty-input {
    width: 48px;
    text-align: center;
    border: 0;
    font-size: 15px;
    font-weight: 600;
    -moz-appearance: textfield;
  }
  .uniko-pdp-qty-input::-webkit-outer-spin-button,
  .uniko-pdp-qty-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .uniko-pdp-atc {
    flex: 1;
    min-width: 200px;
    min-height: 52px;
    border: 0;
    border-radius: 2px;
    background: #1f1c19;
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .uniko-pdp-atc:disabled { background: #8a8178; }
  .uniko-pdp-admin-desc { margin: 0 0 24px; font-size: 15px; line-height: 1.55; }
  .uniko-pdp-accordions { border-top: 1px solid #e5dfd9; }
  .uniko-pdp-acc { border-bottom: 1px solid #e5dfd9; }
  .uniko-pdp-acc summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 700;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .uniko-pdp-acc summary::-webkit-details-marker { display: none; }
  .uniko-pdp-acc summary::after { content: "▾"; font-size: 14px; }
  .uniko-pdp-acc[open] summary::after { content: "▴"; }
  .uniko-pdp-acc-body { padding: 0 0 20px; font-size: 14px; line-height: 1.6; color: #4a4540; }
  .uniko-pdp-cert-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 14px 22px;
    padding: 4px 0 22px;
  }
  .uniko-pdp-cert-badge {
    flex: 0 1 72px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .uniko-pdp-cert-badge img {
    display: block;
    width: auto;
    height: 72px;
    max-width: 84px;
    object-fit: contain;
    filter: brightness(0) saturate(100%) invert(48%) sepia(22%) saturate(820%) hue-rotate(353deg) brightness(94%) contrast(88%);
  }
  .uniko-pdp-sticky {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: #fff;
    border-top: 1px solid #e5dfd9;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.06);
    padding: 12px 18px;
  }
  .uniko-pdp-sticky-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .uniko-pdp-sticky-meta { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .uniko-pdp-sticky-thumb { width: 48px; height: 48px; object-fit: contain; border-radius: 4px; background: #f3ebe3; }
  .uniko-pdp-sticky-title { margin: 0; font-size: 13px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 42vw; }
  .uniko-pdp-sticky-price { margin: 0; font-size: 13px; font-weight: 600; }
  .uniko-pdp-sticky-atc {
    border: 0;
    border-radius: 2px;
    background: #1f1c19;
    color: #fff;
    min-height: 44px;
    padding: 0 22px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }
  @media (min-width: 901px) {
    .uniko-pdp-wrap {
      grid-template-columns: 1.05fr 0.92fr;
      gap: 48px;
      padding: 36px 28px 100px;
      align-items: start;
    }
    .uniko-pdp-gallery-col {
      position: sticky;
      top: calc(var(--site-top, 0px) + 16px);
      margin-left: 0;
      margin-right: 0;
    }
    .uniko-pdp-cert-row {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 10px;
    }
    .uniko-pdp-cert-badge {
      flex: 1 1 0;
      min-width: 0;
    }
    .uniko-pdp-cert-badge img {
      height: 80px;
      max-width: 100%;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    const root = document.querySelector("[data-uniko-pdp]");
    if (!root) return;
    const qtyInput = root.querySelector(".uniko-pdp-qty-input");
    root.querySelector("[data-qty-minus]")?.addEventListener("click", () => {
      if (!qtyInput) return;
      qtyInput.value = String(Math.max(1, parseInt(qtyInput.value, 10) - 1 || 1));
    });
    root.querySelector("[data-qty-plus]")?.addEventListener("click", () => {
      if (!qtyInput) return;
      qtyInput.value = String(Math.max(1, parseInt(qtyInput.value, 10) + 1 || 2));
    });
    const form = root.querySelector("#uniko-pdp-form");
    const sticky = root.querySelector("#uniko-pdp-sticky");
    const stickyAtc = root.querySelector("[data-sticky-atc]");
    const buy = root.querySelector(".uniko-pdp-buy");
    if (sticky && buy) {
      const obs = new IntersectionObserver(([e]) => {
        sticky.hidden = e.isIntersecting;
      }, { threshold: 0, rootMargin: "0px 0px -20px 0px" });
      obs.observe(buy);
    }
    stickyAtc?.addEventListener("click", () => form?.requestSubmit());
  })();
</script>

{% schema %}
{
  "name": "Default product",
  "tag": "section",
  "class": "uniko-product",
  "settings": []
}
{% endschema %}