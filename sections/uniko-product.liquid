{% comment %}Inika-style product page — Uniko Beauties{% endcomment %}
{% assign pdp_profile = section.settings.content_profile | default: 'aloe' %}
<section class="uniko-pdp" id="product" data-uniko-pdp>
  <div class="uniko-pdp-wrap">
    <div class="uniko-pdp-gallery-col">
      <div class="uniko-pdp-main">
        {% if product.featured_media %}
          {{ product.featured_media
            | image_url: width: 1600
            | image_tag:
              class: 'uniko-pdp-main-img',
              loading: 'eager',
              alt: product.title,
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 901px) 54vw, 100vw'
          }}
        {% elsif product.images.first %}
          {{ product.images.first
            | image_url: width: 1600
            | image_tag:
              class: 'uniko-pdp-main-img',
              loading: 'eager',
              alt: product.title,
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 901px) 54vw, 100vw'
          }}
        {% endif %}
      </div>
    </div>

    {% if pdp_profile == 'spray' %}
      {% render 'uniko-pdp-spray-info' %}
    {% elsif pdp_profile == 'hair_milk' %}
      {% render 'uniko-pdp-hair-milk-info' %}
    {% elsif pdp_profile == 'mask_pouss' %}
      {% render 'uniko-pdp-mask-pouss-info' %}
    {% elsif pdp_profile == 'detangling' %}
      {% render 'uniko-pdp-detangling-info' %}
    {% elsif pdp_profile == 'queeny' %}
      {% render 'uniko-pdp-queeny-info' %}
    {% else %}
    <div class="uniko-pdp-info-col">
      <a class="uniko-pdp-back" href="{{ routes.root_url }}">← <span data-i18n="pdp_back">Back to shop</span></a>

      <p class="uniko-pdp-eyebrow">{{ shop.name }}</p>
      <h1 class="uniko-pdp-title">{{ product.title }}</h1>
      <p class="uniko-pdp-subtitle" data-i18n="pdp_subtitle">Shampoo for locks</p>

      <div class="uniko-pdp-rating" role="img" aria-label="5 out of 5 stars">
        <span class="uniko-pdp-stars" aria-hidden="true">★★★★★</span>
        <span class="uniko-pdp-rating-val">5.0</span>
      </div>

      <div class="uniko-pdp-lead rte">
        <p data-i18n="pdp_desc_en">A gentle aloe vera shampoo for body and hair (500 ml). Cleanses while helping maintain moisture and comfort for all skin and hair types. Free from sulfates, silicones and parabens.</p>
        <p class="uniko-pdp-lead-fr" data-i18n="pdp_desc_fr" lang="fr">Shampoing doux à l'aloe vera pour le corps et les cheveux (500 ml). Nettoie tout en préservant l'hydratation — pour tous types de peau et de cheveux. Sans sulfates, silicones ni parabènes.</p>
      </div>

      <p class="uniko-pdp-size" data-i18n="pdp_size">Size: 500 ml</p>

      <div class="uniko-pdp-price-block">
        {% if product.selected_or_first_available_variant.price > 0 %}
          <p class="uniko-pdp-price">{{ product.selected_or_first_available_variant.price | money }}</p>
          {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
            <p class="uniko-pdp-compare"><s>{{ product.selected_or_first_available_variant.compare_at_price | money }}</s></p>
          {% endif %}
        {% endif %}
      </div>

      {% form 'product', product, id: 'uniko-pdp-form', class: 'uniko-pdp-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <div class="uniko-pdp-buy">
          <div class="uniko-pdp-qty">
            <button type="button" class="uniko-pdp-qty-btn" data-qty-minus aria-label="Decrease quantity">−</button>
            <input type="number" name="quantity" value="1" min="1" class="uniko-pdp-qty-input" aria-label="Quantity">
            <button type="button" class="uniko-pdp-qty-btn" data-qty-plus aria-label="Increase quantity">+</button>
          </div>
          <button type="submit" name="add" class="uniko-pdp-atc" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
            {% if product.selected_or_first_available_variant.available %}
              <span data-i18n="pdp_atc">Add to cart</span>
            {% else %}
              <span data-i18n="pdp_soldout">Sold out</span>
            {% endif %}
          </button>
        </div>
      {% endform %}

      {% if product.description != blank %}
        <div class="uniko-pdp-admin-desc rte">{{ product.description }}</div>
      {% endif %}

      <div class="uniko-pdp-accordions">
        <details class="uniko-pdp-acc" open>
          <summary data-i18n="pdp_acc_certs">Certifications</summary>
          <div class="uniko-pdp-cert-row" role="list" aria-label="Certifications">
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-01-ofc-organic.png' | asset_img_url: 'width: 320' }}" alt="Certified Organic Australia" loading="lazy" width="88" height="88">
            </div>
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-02-peta.png' | asset_img_url: 'width: 320' }}" alt="Animal test-free, PETA" loading="lazy" width="88" height="88">
            </div>
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-03-vegan.png' | asset_img_url: 'width: 320' }}" alt="Certified Vegan" loading="lazy" width="88" height="88">
            </div>
            <div class="uniko-pdp-cert-badge" role="listitem">
              <img src="{{ 'uniko-trust-badges-06-halal.png' | asset_img_url: 'width: 320' }}" alt="Halal accredited" loading="lazy" width="88" height="88">
            </div>
          </div>
        </details>

        <details class="uniko-pdp-acc">
          <summary data-i18n="pdp_acc_how">How to use</summary>
          <div class="uniko-pdp-acc-body">
            <p data-i18n="pdp_how_en">Shake well and apply the shampoo 1 to 2 times on the entire hair, from the scalp to the tips, then rinse. Repeat if necessary.</p>
            <p lang="fr" data-i18n="pdp_how_fr">Secouer et appliquez 1 à 2 fois le shampoing sur l'ensemble des cheveux en partant du cuir chevelu aux pointes puis rincer. Renouveler le procédé si nécessaire.</p>
          </div>
        </details>

        <details class="uniko-pdp-acc">
          <summary data-i18n="pdp_acc_ing">Ingredients</summary>
          <div class="uniko-pdp-acc-body">
            <p><strong data-i18n="pdp_ing_label_en">Ingredients:</strong> <span data-i18n="pdp_ing_en">Aloe vera, basil, vegetable oils, natural scented water, sodium hydroxide, water.</span></p>
            <p lang="fr"><strong data-i18n="pdp_ing_label_fr">Ingrédients :</strong> <span data-i18n="pdp_ing_fr">Aloe vera, basilique, huiles végétales, eau de senteur naturel, hydroxyde de sodium, eau.</span></p>
          </div>
        </details>
      </div>
    </div>
    {% endif %}
  </div>

  {% if pdp_profile == 'spray' %}
    {% render 'uniko-pdp-spray-sections' %}
  {% elsif pdp_profile == 'hair_milk' %}
    {% render 'uniko-pdp-hair-milk-sections' %}
  {% elsif pdp_profile == 'mask_pouss' %}
    {% render 'uniko-pdp-mask-pouss-sections' %}
  {% elsif pdp_profile == 'detangling' %}
    {% render 'uniko-pdp-detangling-sections' %}
  {% elsif pdp_profile == 'queeny' %}
    {% render 'uniko-pdp-queeny-sections' %}
  {% else %}
  <div class="uniko-pdp-keys" aria-labelledby="uniko-pdp-keys-title">
    <div class="uniko-pdp-keys-inner">
      <h2 class="uniko-pdp-keys-title" id="uniko-pdp-keys-title" data-i18n="pdp_keys_title">Key Ingredients</h2>
      <div class="uniko-pdp-keys-carousel" data-pdp-ing-carousel>
        <button type="button" class="uniko-pdp-keys-nav uniko-pdp-keys-nav--prev" data-pdp-ing-prev aria-label="Previous ingredients">‹</button>
        <div class="uniko-pdp-keys-track" tabindex="0" role="list">
          <article class="uniko-pdp-key-card" role="listitem">
            <div class="uniko-pdp-key-icon" aria-hidden="true">
              <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
                <path d="M24 4C14 18 10 28 12 38c2 8 8 10 12 10s10-2 12-10c2-10-2-20-12-34Z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M24 20v18M24 28c-4 2-8 2-10 0" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
              </svg>
            </div>
            <div class="uniko-pdp-key-body">
              <h3 class="uniko-pdp-key-name" data-i18n="pdp_key1_title">Aloe Vera</h3>
              <p class="uniko-pdp-key-text" data-i18n="pdp_key1_desc">Helps cleanse gently while supporting moisture and comfort for skin and hair.</p>
            </div>
          </article>
          <article class="uniko-pdp-key-card" role="listitem">
            <div class="uniko-pdp-key-icon" aria-hidden="true">
              <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
                <path d="M10 38c6-14 18-22 28-26M8 30c8-4 16-14 22-24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M18 38c3-6 8-10 14-12M30 40c2-5 6-8 10-10" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
                <circle cx="36" cy="14" r="3" fill="currentColor" opacity="0.35"/>
              </svg>
            </div>
            <div class="uniko-pdp-key-body">
              <h3 class="uniko-pdp-key-name" data-i18n="pdp_key2_title">Basil</h3>
              <p class="uniko-pdp-key-text" data-i18n="pdp_key2_desc">A fresh botanical note in our natural scented water, for a clean, uplifting wash.</p>
            </div>
          </article>
          <article class="uniko-pdp-key-card" role="listitem">
            <div class="uniko-pdp-key-icon" aria-hidden="true">
              <svg class="uniko-pdp-key-svg" width="56" height="56" viewBox="0 0 48 48" fill="none">
                <path d="M24 8c-8 10-11 20-8 28 2.5 6 7 9 12 8 6-1 10-6 10-14 0-12-10-22-14-22Z" stroke="currentColor" stroke-width="1.5"/>
                <path d="M24 18v8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" opacity="0.7"/>
              </svg>
            </div>
            <div class="uniko-pdp-key-body">
              <h3 class="uniko-pdp-key-name" data-i18n="pdp_key3_title">Vegetable oils</h3>
              <p class="uniko-pdp-key-text" data-i18n="pdp_key3_desc">Plant-derived oils help leave hair feeling soft and cared for after every rinse.</p>
            </div>
          </article>
        </div>
        <button type="button" class="uniko-pdp-keys-nav uniko-pdp-keys-nav--next" data-pdp-ing-next aria-label="Next ingredients">›</button>
      </div>
    </div>
  </div>

  <div class="uniko-pdp-faq">
    <div class="uniko-pdp-block-inner">
      <h2 class="uniko-pdp-block-title" data-i18n="pdp_faq_title">Frequently asked questions</h2>
      <div class="uniko-pdp-faq-list">
        <details class="uniko-pdp-faq-item">
          <summary data-i18n="pdp_faq_q1">Can I use this on hair and body?</summary>
          <p data-i18n="pdp_faq_a1">Yes. This 500 ml formula is designed for both hair and body in one gentle wash.</p>
        </details>
        <details class="uniko-pdp-faq-item">
          <summary data-i18n="pdp_faq_q2">Is it sulfate, silicone and paraben free?</summary>
          <p data-i18n="pdp_faq_a2">Yes. It is made without sulfates, silicones or parabens for a cleaner everyday routine.</p>
        </details>
        <details class="uniko-pdp-faq-item">
          <summary data-i18n="pdp_faq_q3">How often should I shampoo?</summary>
          <p data-i18n="pdp_faq_a3">Use 1 to 2 washes per session, from scalp to tips, then rinse. Repeat only if needed.</p>
        </details>
        <details class="uniko-pdp-faq-item">
          <summary data-i18n="pdp_faq_q4">Is it suitable for sensitive skin?</summary>
          <p data-i18n="pdp_faq_a4">The aloe-led formula is crafted to cleanse gently while helping maintain comfort for different skin types.</p>
        </details>
      </div>
    </div>
  </div>

  <div class="uniko-pdp-compare">
    <div class="uniko-pdp-block-inner">
      <h2 class="uniko-pdp-block-title" data-i18n="pdp_compare_title">How we compare</h2>
      <div class="uniko-pdp-compare-scroll">
        <table class="uniko-pdp-compare-table">
          <thead>
            <tr>
              <th scope="col" data-i18n="pdp_cmp_feature">Feature</th>
              <th scope="col" class="is-highlight">{{ product.title }}</th>
              <th scope="col" data-i18n="pdp_cmp_conv">Conventional shampoo</th>
              <th scope="col" data-i18n="pdp_cmp_other">Typical “natural” claim</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row" data-i18n="pdp_cmp_row1">Sulfate free</th>
              <td class="is-highlight"><span class="uniko-pdp-yes" aria-label="Yes">✓</span></td>
              <td><span class="uniko-pdp-no" aria-label="No">—</span></td>
              <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_sometimes">Sometimes</span></td>
            </tr>
            <tr>
              <th scope="row" data-i18n="pdp_cmp_row2">Silicone free</th>
              <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
              <td><span class="uniko-pdp-no">—</span></td>
              <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_sometimes">Sometimes</span></td>
            </tr>
            <tr>
              <th scope="row" data-i18n="pdp_cmp_row3">Paraben free</th>
              <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
              <td><span class="uniko-pdp-no">—</span></td>
              <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_sometimes">Sometimes</span></td>
            </tr>
            <tr>
              <th scope="row" data-i18n="pdp_cmp_row4">Hair + body (500 ml)</th>
              <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
              <td><span class="uniko-pdp-no">—</span></td>
              <td><span class="uniko-pdp-no">—</span></td>
            </tr>
            <tr>
              <th scope="row" data-i18n="pdp_cmp_row5">Certified organic ingredients</th>
              <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
              <td><span class="uniko-pdp-no">—</span></td>
              <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
            </tr>
            <tr>
              <th scope="row" data-i18n="pdp_cmp_row6">Vegan & cruelty-free</th>
              <td class="is-highlight"><span class="uniko-pdp-yes">✓</span></td>
              <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
              <td><span class="uniko-pdp-maybe" data-i18n="pdp_cmp_varies">Varies</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <section class="reviews-section uniko-pdp-reviews" id="pdp-avis" aria-labelledby="pdp-reviews-title">
    <div class="uniko-pdp-block-inner">
      <div class="reviews-head">
        <h2 id="pdp-reviews-title" data-i18n="pdp_reviews_title">Customer reviews</h2>
        <div class="reviews-meta" aria-label="Average rating 5 out of 5">
          <span class="review-stars" aria-hidden="true">★★★★★</span>
          <span data-i18n="pdp_reviews_meta">5.0 · 42 reviews</span>
        </div>
      </div>
      <div class="review-cards-carousel" data-pdp-review-carousel>
        <button type="button" class="carousel-btn carousel-btn--prev" data-carousel-prev aria-label="Previous reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M14.5 5.5 9 11l5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="review-cards-track" tabindex="0" role="list">
          <article class="review-card" role="listitem">
            <div class="review-card-top">
              <div>
                <p class="review-card-name">Amira K.</p>
                <p class="review-verified">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#3d6ea8"/><path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span data-i18n="verified_buyer">Verified buyer</span>
                </p>
              </div>
              <time class="review-card-date" datetime="2026-10-12">12/10/26</time>
            </div>
            <p class="review-card-stars" aria-hidden="true">★★★★★</p>
            <h3 class="review-card-title" data-i18n="pdp_rev1_title">Gentle on my curls</h3>
            <p class="review-card-body" data-i18n="pdp_rev1_body">Cleans without stripping. My scalp feels calm and my locks stay soft after every wash.</p>
            <div class="review-card-product">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 80 | image_tag: class: 'review-product-thumb', alt: '' }}
              {% else %}
                <div class="review-product-thumb" aria-hidden="true"></div>
              {% endif %}
              <p class="review-product-name">{{ product.title }}</p>
            </div>
          </article>
          <article class="review-card" role="listitem">
            <div class="review-card-top">
              <div>
                <p class="review-card-name">James T.</p>
                <p class="review-verified">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#3d6ea8"/><path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span data-i18n="verified_review">Verified review</span>
                </p>
              </div>
              <time class="review-card-date" datetime="2026-09-08">08/09/26</time>
            </div>
            <p class="review-card-stars" aria-hidden="true">★★★★★</p>
            <h3 class="review-card-title" data-i18n="pdp_rev2_title">One bottle for shower</h3>
            <p class="review-card-body" data-i18n="pdp_rev2_body">Love using the same aloe shampoo on hair and body — simple and smells fresh, not heavy.</p>
            <div class="review-card-product">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 80 | image_tag: class: 'review-product-thumb', alt: '' }}
              {% else %}
                <div class="review-product-thumb" aria-hidden="true"></div>
              {% endif %}
              <p class="review-product-name">{{ product.title }}</p>
            </div>
          </article>
          <article class="review-card" role="listitem">
            <div class="review-card-top">
              <div>
                <p class="review-card-name">Sarah L.</p>
                <p class="review-verified">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#3d6ea8"/><path d="M5 8l2 2 4-4" stroke="#fff" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span data-i18n="verified_buyer">Verified buyer</span>
                </p>
              </div>
              <time class="review-card-date" datetime="2026-08-01">01/08/26</time>
            </div>
            <p class="review-card-stars" aria-hidden="true">★★★★★</p>
            <h3 class="review-card-title" data-i18n="pdp_rev3_title">No harsh foam</h3>
            <p class="review-card-body" data-i18n="pdp_rev3_body">Sulfate-free lather is light but my hair feels clean. Great for my sensitive skin too.</p>
            <div class="review-card-product">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 80 | image_tag: class: 'review-product-thumb', alt: '' }}
              {% else %}
                <div class="review-product-thumb" aria-hidden="true"></div>
              {% endif %}
              <p class="review-product-name">{{ product.title }}</p>
            </div>
          </article>
        </div>
        <button type="button" class="carousel-btn carousel-btn--next" data-carousel-next aria-label="Next reviews">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M9.5 5.5 15 11l-5.5 5.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </section>
  {% endif %}

  <div class="uniko-pdp-sticky" id="uniko-pdp-sticky" hidden>
    <div class="uniko-pdp-sticky-inner">
      <div class="uniko-pdp-sticky-meta">
        {% if product.featured_image %}
          {{ product.featured_image | image_url: width: 120 | image_tag: class: 'uniko-pdp-sticky-thumb', alt: '' }}
        {% endif %}
        <div>
          <p class="uniko-pdp-sticky-title">{{ product.title }}</p>
          {% if product.price > 0 %}
            <p class="uniko-pdp-sticky-price">{{ product.price | money }}</p>
          {% endif %}
        </div>
      </div>
      <button type="button" class="uniko-pdp-sticky-atc" data-sticky-atc data-i18n="pdp_atc">Add to cart</button>
    </div>
  </div>
</section>

{% stylesheet %}
  .uniko-pdp {
    background: #fff;
    width: 100%;
    max-width: 100%;
    overflow-x: clip;
  }
  .uniko-pdp-wrap {
    max-width: 1320px;
    width: 100%;
    min-width: 0;
    margin: 0 auto;
    padding: 20px 18px 80px;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .uniko-pdp-gallery-col {
    min-width: 0;
    max-width: 100%;
    background: #ffffff;
  }
  .uniko-pdp-main {
    background: #ffffff;
    border: 0;
    border-radius: 0;
    min-height: 0;
    padding: 12px 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
  }
  .uniko-pdp-main-img {
    display: block;
    width: auto;
    max-width: min(78vw, 320px);
    height: auto;
    max-height: min(38vh, 340px);
    object-fit: contain;
    object-position: center;
    border: 0;
    margin: 0 auto;
    background: #ffffff;
  }
  .uniko-pdp-back { font-size: 14px; font-weight: 600; color: #6a625a; text-decoration: none; }
  .uniko-pdp-eyebrow {
    margin: 16px 0 8px;
