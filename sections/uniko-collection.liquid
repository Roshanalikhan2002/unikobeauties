<section class="uniko-page uniko-collection-page">
  <div class="uniko-page-inner">
    <h1 class="uniko-page-title">
      {% if collection.handle == 'all' %}
        <span data-i18n="collection_title">Shop</span>
      {% else %}
        {{ collection.title }}
      {% endif %}
    </h1>
    {% if collection.products_count > 0 %}
      <p class="uniko-search-count">{{ collection.products_count }} <span data-i18n="collection_count">products</span></p>
    {% endif %}

    {% paginate collection.products by 50 %}
      {% if collection.products.size == 0 %}
        <p class="uniko-cart-empty" data-i18n="collection_empty">No products yet.</p>
      {% else %}
        <div class="uniko-search-grid uniko-collection-grid">
          {% for product in collection.products %}
            <article class="uniko-collection-card">
              <a class="uniko-collection-card-link" href="{{ product.url }}">
                <div class="uniko-search-card-media">
                  {% if product.featured_media %}
                    {{ product.featured_media | image_url: width: 720 | image_tag: loading: 'lazy', alt: product.title }}
                  {% endif %}
                </div>
                <h2>{{ product.title }}</h2>
                <p class="uniko-collection-card-price">
                  <span>{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <span class="uniko-collection-card-was">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </p>
              </a>
              <a class="category-card-shop-btn" href="{{ product.url }}" data-i18n="shop_now">Shop now</a>
            </article>
          {% endfor %}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>
{% schema %}
{
  "name": "Uniko collection",
  "tag": "section",
  "class": "uniko-collection-section",
  "settings": []
}
{% endschema %}
