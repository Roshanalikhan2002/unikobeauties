{% comment %}Global site header{% endcomment %}
<div class="site-top" id="site-top">
  <div class="promo-bar" role="region" data-i18n-aria="promo_aria" data-i18n="promo">Free delivery on orders over&nbsp;€95</div>
  <header class="header" id="site-header">
    <div class="header-top">
      <button class="icon-btn menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu">
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true">
          <path d="M1 1.5h20M1 8h20M1 14.5h20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

      <div class="header-left-slot" aria-hidden="true"></div>

      <a class="logo" href="{{ routes.root_url }}" aria-label="Uniko Beauties, home">
        <img class="logo-img" src="{{ 'uniko-brand-logo.png' | asset_img_url: 'master' }}" alt="Uniko Beauties" width="358" height="250">
      </a>

      <div class="header-tools">
        <nav class="lang-switch" aria-label="Site language">
          <button type="button" class="lang-set" data-set-lang="en" hreflang="en" lang="en" aria-current="true" title="English">EN</button>
          <span aria-hidden="true">·</span>
          <button type="button" class="lang-set" data-set-lang="fr" hreflang="fr" lang="fr" title="Français">FR</button>
        </nav>
        <button class="icon-btn mobile-search" type="button" data-uniko-open-search aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.6"/>
            <path d="M16 16.5L20 20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <button class="icon-btn desktop-search" type="button" data-uniko-open-search aria-label="Search">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="6.25" stroke="currentColor" stroke-width="1.6"/>
            <path d="M16 16.5L20 20.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </button>
        <a class="icon-btn header-account" href="{{ routes.account_url }}" aria-label="Account">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6"/>
            <path d="M5.2 19.2c1.4-3 3.8-4.4 6.8-4.4s5.4 1.4 6.8 4.4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </a>
        <a class="icon-btn" href="{{ routes.cart_url }}" data-uniko-open-cart aria-label="Cart, {{ cart.item_count }} items">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6.5 8.5h11l-.8 10.2a1.5 1.5 0 0 1-1.5 1.3H8.8a1.5 1.5 0 0 1-1.5-1.3L6.5 8.5z" stroke="currentColor" stroke-width="1.6"/>
            <path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
          </svg>
          <span class="cart-count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>

    <nav class="nav" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}" data-i18n="nav_shop">Shop</a>
      <a href="/products/aloe-vera-shampoo" data-i18n="nav_skincare">Hair</a>
      <a href="/products/yiri-soap" data-i18n="nav_makeup">Face</a>
      <a href="/products/rajel-beard-spray" data-i18n="nav_beard">Beard</a>
      <a href="/products/moisturizing-balm" data-i18n="nav_clearance">Body</a>
      <a href="{{ routes.root_url }}#a-propos" data-i18n="nav_about">About</a>
    </nav>
  </header>
  </div>
  <button type="button" class="mobile-menu-overlay" id="mobile-overlay" aria-label="Close menu" tabindex="-1"></button>
  <aside class="mobile-side-drawer" id="mobile-nav" aria-label="Mobile navigation" aria-hidden="true">
    <div class="mobile-drawer-shimmer" aria-hidden="true"></div>
    <div class="mobile-drawer-head">
      <img class="mobile-drawer-brand-img" src="{{ 'uniko-brand-logo.png' | asset_img_url: 'master' }}" alt="Uniko Beauties" width="358" height="250">
      <button type="button" class="mobile-drawer-close" id="mobile-menu-close" aria-label="Close menu">×</button>
    </div>
    <nav class="mobile-drawer-nav">
      <a href="{{ routes.all_products_collection_url }}" data-i18n="nav_shop">Shop</a>
      <a href="/products/aloe-vera-shampoo" data-i18n="nav_skincare">Hair</a>
      <a href="/products/yiri-soap" data-i18n="nav_makeup">Face</a>
      <a href="/products/rajel-beard-spray" data-i18n="nav_beard">Beard</a>
      <a href="/products/moisturizing-balm" data-i18n="nav_clearance">Body</a>
      <a href="{{ routes.root_url }}#a-propos" data-i18n="nav_about">About</a>
    </nav>
    <p class="mobile-drawer-note" data-i18n="drawer_note">Hair, face, beard and body</p>
  </aside>
<script>
(function () {
  const siteTop = document.getElementById("site-top");
  if (!siteTop) return;
  const syncTopOffset = () =>
    document.documentElement.style.setProperty("--site-top", siteTop.offsetHeight + "px");
  syncTopOffset();
  window.addEventListener("resize", syncTopOffset);
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");
  const drawer = document.getElementById("mobile-nav");
  const overlay = document.getElementById("mobile-overlay");
  const menuClose = document.getElementById("mobile-menu-close");
  const setMobileMenuOpen = (open) => {
    header?.classList.toggle("is-open", open);
    document.body.classList.toggle("menu-open", open);
    drawer?.setAttribute("aria-hidden", open ? "false" : "true");
    toggle?.setAttribute("aria-expanded", open ? "true" : "false");
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (!open) requestAnimationFrame(syncTopOffset);
  };
  toggle?.addEventListener("click", () => setMobileMenuOpen(!document.body.classList.contains("menu-open")));
  overlay?.addEventListener("click", () => setMobileMenuOpen(false));
  menuClose?.addEventListener("click", () => setMobileMenuOpen(false));
  drawer?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMobileMenuOpen(false)));
  window.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && document.body.classList.contains("menu-open")) setMobileMenuOpen(false);
  });
})();
</script>
{% render 'uniko-cart-search' %}

