  <script>
    const siteTop = document.getElementById("site-top");

    const syncTopOffset = () => {
      document.documentElement.style.setProperty("--site-top", `${siteTop.offsetHeight}px`);
    };

    syncTopOffset();
    window.addEventListener("resize", syncTopOffset);

    const header = document.getElementById("site-header");
    const toggle = document.getElementById("menu-toggle");
    const drawer = document.getElementById("mobile-nav");

    toggle.addEventListener("click", () => {
      const open = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      requestAnimationFrame(syncTopOffset);
    });

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        header.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open menu");
      });
    });

    const impactSection = document.getElementById("durabilite");
    const impactZoom = document.querySelector("[data-impact-zoom]");
    const canAnimateZoom = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const updateImpactZoom = () => {
      if (!impactSection || !impactZoom || !canAnimateZoom) return;

      const rect = impactSection.getBoundingClientRect();
      const view = window.innerHeight;
      const total = view + rect.height;
      const traveled = view - rect.top;
      const progress = Math.min(1, Math.max(0, traveled / total));
      const scale = 1.06 + progress * 0.16;

      impactZoom.style.setProperty("--impact-scale", scale.toFixed(3));
    };

  window.addEventListener("scroll", updateImpactZoom, { passive: true });
    window.addEventListener("resize", updateImpactZoom);
    updateImpactZoom();

    const initTranslateLinks = () => {
      const pageUrl = encodeURIComponent(window.location.href.split("#")[0]);
      document.querySelectorAll("[data-translate-lang]").forEach((link) => {
        const targetLang = link.getAttribute("data-translate-lang");
        if (!targetLang) return;
        link.href = `https://translate.google.com/translate?sl=en&tl=${targetLang}&u=${pageUrl}`;
        link.rel = "noopener noreferrer";
      });
    };

    initTranslateLinks();

    document.querySelectorAll("[data-review-carousel]").forEach((carousel) => {
      const track = carousel.querySelector(".review-cards-track");
      const prev = carousel.querySelector("[data-carousel-prev]");
      const next = carousel.querySelector("[data-carousel-next]");

      const scrollStep = () => {
        const card = track.querySelector(".review-card");
        if (!card) return 358;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 18;
        return card.getBoundingClientRect().width + gap;
      };

      prev?.addEventListener("click", () => {
        track.scrollBy({ left: -scrollStep(), behavior: "smooth" });
      });

      next?.addEventListener("click", () => {
        track.scrollBy({ left: scrollStep(), behavior: "smooth" });
      });
    });
  </script>
