  <script src="{{ 'uniko-i18n.js' | asset_url }}" defer></script>
  <script>
    const siteTop = document.getElementById("site-top");

    const syncTopOffset = () => {
      document.documentElement.style.setProperty("--site-top", `${siteTop.offsetHeight}px`);
    };

    syncTopOffset();
    window.addEventListener("resize", syncTopOffset);

    const header = document.getElementById("site-header");
    const toggle = document.getElementById("menu-toggle");
    const drawer = document.getElementById("mobile-nav");
    const overlay = document.getElementById("mobile-overlay");
    const menuClose = document.getElementById("mobile-menu-close");

    const setMobileMenuOpen = (open) => {
      header.classList.toggle("is-open", open);
      document.body.classList.toggle("menu-open", open);
      drawer.setAttribute("aria-hidden", open ? "false" : "true");
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (!open) requestAnimationFrame(syncTopOffset);
    };

    toggle.addEventListener("click", () => {
      setMobileMenuOpen(!document.body.classList.contains("menu-open"));
    });

    overlay?.addEventListener("click", () => setMobileMenuOpen(false));
    menuClose?.addEventListener("click", () => setMobileMenuOpen(false));

    drawer.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setMobileMenuOpen(false));
    });

    window.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && document.body.classList.contains("menu-open")) {
        setMobileMenuOpen(false);
      }
    });

    const impactSection = document.getElementById("durabilite");
    const impactZoom = document.querySelector("[data-impact-zoom]");
    const canAnimateZoom = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const updateImpactZoom = () => {
      if (!impactSection || !impactZoom || !canAnimateZoom) return;

      const rect = impactSection.getBoundingClientRect();
      const view = window.innerHeight;
      const total = view + rect.height;
      const traveled = view - rect.top;
      const progress = Math.min(1, Math.max(0, traveled / total));
      const scale = 1.06 + progress * 0.16;

      impactZoom.style.setProperty("--impact-scale", scale.toFixed(3));
    };

  window.addEventListener("scroll", updateImpactZoom, { passive: true });
    window.addEventListener("resize", updateImpactZoom);
    updateImpactZoom();

    document.querySelectorAll("[data-review-carousel]").forEach((carousel) => {
      const track = carousel.querySelector(".review-cards-track");
      const prev = carousel.querySelector("[data-carousel-prev]");
      const next = carousel.querySelector("[data-carousel-next]");

      const scrollStep = () => {
        const card = track.querySelector(".review-card");
        if (!card) return 358;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 18;
        return card.getBoundingClientRect().width + gap;
      };

      prev?.addEventListener("click", () => {
        track.scrollBy({ left: -scrollStep(), behavior: "smooth" });
      });

      next?.addEventListener("click", () => {
        track.scrollBy({ left: scrollStep(), behavior: "smooth" });
      });
    });

    document.querySelectorAll("[data-category-carousel]").forEach((wrap) => {
      const track = wrap.querySelector(".category-track");
      const prev = wrap.querySelector("[data-category-prev]");
      const next = wrap.querySelector("[data-category-next]");
      if (!track) return;

      const scrollStep = () => {
        const card = track.querySelector(".category-product-item, .category-card");
        if (!card) return 298;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 18;
        return card.getBoundingClientRect().width + gap;
      };

      prev?.addEventListener("click", () => {
        track.scrollBy({ left: -scrollStep(), behavior: "smooth" });
      });

      next?.addEventListener("click", () => {
        track.scrollBy({ left: scrollStep(), behavior: "smooth" });
      });
    });

    document.querySelectorAll("[data-trust-carousel]").forEach((wrap) => {
      const track = wrap.querySelector(".trust-track");
      const prev = wrap.querySelector("[data-trust-prev]");
      const next = wrap.querySelector("[data-trust-next]");
      if (!track) return;

      const scrollStep = () => {
        const badge = track.querySelector(".trust-badge");
        if (!badge) return 140;
        const gap = parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 24;
        return badge.getBoundingClientRect().width + gap;
      };

      const syncTrustNav = () => {
        const max = track.scrollWidth - track.clientWidth;
        const atStart = track.scrollLeft <= 8;
        const atEnd = track.scrollLeft >= max - 8 || max <= 8;
        wrap.classList.toggle("is-start", atStart);
        wrap.classList.toggle("is-end", atEnd);
        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd;
      };

      prev?.addEventListener("click", () => {
        track.scrollBy({ left: -scrollStep(), behavior: "smooth" });
      });
      next?.addEventListener("click", () => {
        track.scrollBy({ left: scrollStep(), behavior: "smooth" });
      });
      track.addEventListener("scroll", syncTrustNav, { passive: true });
      window.addEventListener("resize", syncTrustNav);
      syncTrustNav();
    });
  </script>
