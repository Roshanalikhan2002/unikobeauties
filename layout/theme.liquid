<!doctype html>
<html lang="en" dir="ltr" translate="no">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="content-language" content="en">
  <meta name="language" content="English">
  <meta name="google" content="notranslate">
  {%- liquid
    assign brand_name = 'Uniko Beauties'
    if template.name == 'index' or page_title == blank or page_title == shop.name or page_title == 'My Store'
      assign tab_title = brand_name
    else
      assign tab_title = page_title | replace: 'My Store', brand_name | append: ' | ' | append: brand_name
    endif
  -%}
  <title>{{ tab_title }}</title>
  {%- if page_description != blank -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- elsif template.name == 'index' -%}
    <meta name="description" content="Uniko Beauties: botanical hair, face, beard and body care with aloe vera. YIRI Soap, Facial Spray, Rajel Beard Spray, Hair Milk and Moisturizing Balm.">
  {%- endif -%}
  {{ content_for_header }}
  <link rel="icon" type="image/png" href="{{ 'uniko-brand-logo.png' | asset_url }}">
  <link rel="shortcut icon" type="image/png" href="{{ 'uniko-brand-logo.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'uniko-brand-logo.png' | asset_url }}">
  {{ 'uniko.css' | asset_url | stylesheet_tag }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
  <script type="speculationrules">
    {
      "prerender": [{
        "where": { "href_matches": "/*" },
        "eagerness": "moderate"
      }]
    }
  </script>
</head>
<body class="uniko-body">
  {{ content_for_layout }}
  <script src="{{ 'uniko-i18n.js' | asset_url }}" defer></script>
  <script src="{{ 'uniko-cart.js' | asset_url }}" defer></script>
</body>
</html>
